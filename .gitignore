.worktrees/

# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# ingest downloads (large PDFs, not committed)
scripts/ingest/downloads/

# local Claude Code tooling (3rd-party skills, dev-server launch config,
# stray worktree artifacts, runtime hook stats) - not project code.
# settings.json/hooks/agents/rules ARE project code (shared config, versioned
# on purpose so any session/collaborator gets the same setup) - un-ignored below.
.claude/*
!.claude/settings.json
!.claude/hooks/
!.claude/agents/
!.claude/rules/

# graphify knowledge-graph output - generated artifact, not project code
graphify-out/
